NODE_ENV=development
PORT=3333

# MongoDB connection string (local Docker: docker compose up -d mongo)
MONGODB_URI=mongodb://localhost:27017/growth-machine

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Number of reverse proxies in front of the API (0 when exposed directly)
TRUST_PROXY=0

LOG_LEVEL=info
